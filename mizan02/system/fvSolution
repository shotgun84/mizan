FoamFile{format ascii;class dictionary;location "system";object fvSolution;}
solvers{p{solver GAMG;tolerance 1e-6;relTol 0.1;smoother GaussSeidel;}
pcorr{solver GAMG;tolerance 1e-6;relTol 0;smoother GaussSeidel;}
"(U|k|omega|C)"{solver smoothSolver;smoother symGaussSeidel;tolerance 1e-5;relTol 0.1;}}
SIMPLE{nNonOrthogonalCorrectors 0;consistent yes;residualControl{p 1e-5;U 1e-5;"(k|omega|C)" 1e-5;}}
relaxationFactors{equations{U 0.9;".*" 0.9;}}
